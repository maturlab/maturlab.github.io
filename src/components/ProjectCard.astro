---
import Rich from './Rich.astro';
import { Image } from 'astro:assets';
import { getEntries, type CollectionEntry } from 'astro:content';
import Avatar from './Avatar.astro';
import { routes, t, ui, url, type Lang } from '../i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
}

const { project, lang } = Astro.props;
const { data } = project;
const s = ui[lang];
const members = (await getEntries(data.members)).filter(Boolean);
const students = members.filter((m) => m.data.role !== 'pi');
const href = url(`${routes[lang].projects}/${project.id}`);
---

<article class="card" data-status={data.status}>
  {
    data.image && (
      <div class="cover">
        <Image src={data.image} alt="" width={640} height={400} fit="cover" />
      </div>
    )
  }
  <div class="body">
    <div class="meta">
      <span class="status" data-status={data.status}>{s.status[data.status]}</span>
      <span class="muted">{data.years}</span>
    </div>
    <h3><a href={href}><Rich text={t(data.title, lang)} /></a></h3>
    {data.summary && <p class="summary"><Rich text={t(data.summary, lang)} /></p>}
    <div class="foot">
      {
        students.length > 0 ? (
          <ul class="members" aria-label={s.projectTeam}>
            {students.map((m) => (
              <li>
                <Avatar name={m.data.name} photo={m.data.photo} size={26} />
                <span>
                  {m.data.name}
                  {data.fellows.some((f) => f.id === m.id) && <small>{s.fellow}</small>}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <span />
        )
      }
      {data.funding && <span class="funding">{t(data.funding, lang)}</span>}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }
  .cover {
    aspect-ratio: 16 / 10;
    background: #efece5;
    overflow: hidden;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.4rem 1.5rem 1.35rem;
    flex: 1;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
  }
  h3 {
    font-size: 1.25rem;
    line-height: 1.25;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .summary {
    font-size: 0.925rem;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .foot {
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .members {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .members li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 500;
  }
  .members :global(.avatar) {
    border-radius: 50%;
    font-size: 0.58rem;
    font-family: var(--sans);
    font-weight: 600;
  }
  .members small {
    display: block;
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--muted);
  }
  .funding {
    font-size: 0.75rem;
    color: var(--muted);
    text-align: right;
    max-width: 50%;
  }
</style>
