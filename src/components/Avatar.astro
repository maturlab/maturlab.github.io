---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  photo?: ImageMetadata;
  size: number;
  class?: string;
}

const { name, photo, size, class: className } = Astro.props;
const initials = name
  .replace(/^(Prof\.|Doç\.|Dr\.|Arş\.|Gör\.|Öğr\.|Üyesi)\s*/g, '')
  .split(/\s+/)
  .filter((w) => !/\.$/.test(w))
  .map((w) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toLocaleUpperCase('tr');
---

{
  photo ? (
    <Image
      class:list={['avatar', className]}
      src={photo}
      alt={name}
      width={size}
      height={size}
      densities={[1, 2]}
      fit="cover"
      style={`--size:${size}px`}
    />
  ) : (
    <span class:list={['avatar', 'placeholder', className]} style={`--size:${size}px`} role="img" aria-label={name}>
      {initials}
    </span>
  )
}

<style>
  .avatar {
    width: var(--size);
    height: var(--size);
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    background: #ebe8e1;
    filter: grayscale(0.15);
  }
  .placeholder {
    display: grid;
    place-items: center;
    font-family: var(--serif);
    font-size: min(calc(var(--size) * 0.34), 3.25rem);
    color: var(--muted);
    letter-spacing: 0.02em;
    user-select: none;
  }
</style>
