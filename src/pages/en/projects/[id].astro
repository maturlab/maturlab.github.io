---
import View from '../../../views/Project.astro';
import { getProjects } from '../../../lib/data';

export async function getStaticPaths() {
  return (await getProjects()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<View lang="en" project={entry} />
