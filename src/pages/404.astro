---
import Base from '../layouts/Base.astro';
---

<Base lang="tr" title="404" altPath="/en">
  <section class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>Sayfa bulunamadı</h1>
    <p class="lead">Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir. / The page you are looking for could not be found.</p>
    <p><a href={import.meta.env.BASE_URL}>Ana sayfaya dön / Back to home →</a></p>
  </section>
</Base>

<style>
  .nf {
    padding-block: 6rem;
    display: grid;
    gap: 1.25rem;
  }
</style>
