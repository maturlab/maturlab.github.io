---
import Base from '../layouts/Base.astro';
import { routes, ui, type Lang } from '../i18n';
import { site } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = ui[lang];
---

<Base lang={lang} title={s.nav.contact} altPath={routes[lang === 'tr' ? 'en' : 'tr'].contact} current="contact">
  <header class="page-head wrap">
    <p class="eyebrow">MICE LAB</p>
    <h1>{s.nav.contact}</h1>
    <p class="lead">{s.contactIntro}</p>
  </header>

  <section class="wrap grid">
    <div class="info">
      <div>
        <h2 class="eyebrow">{s.address}</h2>
        <address>
          {site.address[lang].map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
        </address>
      </div>
      <div>
        <h2 class="eyebrow">{s.email}</h2>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div class="join">
        <h2>{s.joinTitle}</h2>
        <p>{s.joinText}</p>
      </div>
    </div>
    <div class="map">
      <iframe
        title={lang === 'tr' ? 'Harita' : 'Map'}
        src={`https://www.openstreetmap.org/export/embed.html?bbox=${site.map.bbox}&layer=mapnik&marker=${site.map.lat},${site.map.lon}`}
        loading="lazy"></iframe>
      <a class="arrow-link" href={`https://www.openstreetmap.org/?mlat=${site.map.lat}&mlon=${site.map.lon}#map=16/${site.map.lat}/${site.map.lon}`} target="_blank" rel="noopener">
        {lang === 'tr' ? 'Büyük haritada aç' : 'Open larger map'}
      </a>
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 4rem;
    padding-block: 3rem 5rem;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  address {
    font-style: normal;
    margin-top: 0.5rem;
    font-size: 1.05rem;
  }
  .info p {
    margin-top: 0.5rem;
    font-size: 1.05rem;
  }
  .join {
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
  }
  .join h2 {
    font-size: 1.35rem;
  }
  .join p {
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .map iframe {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    filter: grayscale(0.6) contrast(1.05);
    margin-bottom: 0.75rem;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
